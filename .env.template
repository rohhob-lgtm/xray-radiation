# ============================================================================
# XRay-Expert-Assistant — Local Development Environment
# ============================================================================
# Copy this file to .env and adjust values as needed
# Defaults are provided for all variables

# ─────────────────────────────────────────────────────────────────────────
# Server & Ports
# ─────────────────────────────────────────────────────────────────────────
PORT=8000                          # Python backend (FastAPI)
FRONTEND_PORT=5173                # React frontend (Vite)

# ─────────────────────────────────────────────────────────────────────────
# Authentication (LOCAL DEVELOPMENT)
# ─────────────────────────────────────────────────────────────────────────
# For local development WITHOUT Replit OIDC, set:
DISABLE_AUTH=true                 # Disables Replit OAuth; use /api/auth/mock instead

# For Replit deployment (production), leave DISABLE_AUTH unset or false:
# REPL_ID=your-replit-project-id
# REPLIT_DEV_DOMAIN=your-dev.replit.dev
# REPLIT_DOMAINS=your.replit.dev

SESSION_SECRET=dev-secret-change-in-production

# ─────────────────────────────────────────────────────────────────────────
# Database (Optional — defaults to in-memory store if not set)
# ─────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/xray

# ─────────────────────────────────────────────────────────────────────────
# AI Provider (Optional — defaults to MockProvider)
# ─────────────────────────────────────────────────────────────────────────
ACTIVE_PROVIDER=mock               # Options: mock (no API key) | openai | ollama | copilot

# OpenAI (requires API key, not needed for local dev)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Ollama (for local LLM, requires running ollama server)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Microsoft Copilot / Azure OpenAI (enterprise)
# COPILOT_API_KEY=...
# COPILOT_ENDPOINT=...
# COPILOT_DEPLOYMENT=gpt-4

# ─────────────────────────────────────────────────────────────────────────
# File Upload Settings
# ─────────────────────────────────────────────────────────────────────────
# Max file size for uploads (MB)
# MAX_UPLOAD_SIZE_MB=2000

# Max PDF pages per upload
# MAX_PDF_PAGES=5000

# Max PowerPoint slides per upload
# MAX_PPTX_SLIDES=2000

# ─────────────────────────────────────────────────────────────────────────
# Frontend Build
# ─────────────────────────────────────────────────────────────────────────
# BASE_PATH defaults to "/" if not set (Vite uses this for asset paths)
BASE_PATH=/

NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────
# Translation Rate Limits
# ─────────────────────────────────────────────────────────────────────────
# auto: enforce in production, disable in local/dev mode
# on: always enforce
# off: disable hourly limiter
TRANSLATION_RATE_LIMIT_MODE=auto
TRANSLATION_LOCALHOST_UNLIMITED=true
# Used only when limiter is enabled
MAX_REQUESTS_PER_USER_PER_HOUR=10
