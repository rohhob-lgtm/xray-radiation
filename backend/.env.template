# ============================================================================
# Backend — Local Development Environment
# ============================================================================
# Copy this to .env in the backend/ directory

PORT=8000
DISABLE_AUTH=true
SESSION_SECRET=dev-secret-change-in-production
ACTIVE_PROVIDER=mock
DEVELOPMENT_MODE=true
DISABLE_TRANSLATION_RATE_LIMIT=true
DISABLE_HOURLY_QUOTA=true
DISABLE_DAILY_QUOTA=true
DISABLE_MONTHLY_QUOTA=true
LOCAL_DEVELOPER_USER_IDS=dev-user-local

# ============================================================================
# Production hardening (see api/config.py + api/security/)
# ============================================================================
# Set ENVIRONMENT=production to enforce the hardened profile:
#   • secure cookies (Secure + SameSite=Strict + HttpOnly)
#   • interactive API docs (/api/docs, /api/redoc, /api/openapi.json) disabled
#   • HSTS emitted, auto-reload disabled
#   • startup ABORTS if SESSION_SECRET/DISABLE_AUTH/DEBUG/CORS are insecure
# ENVIRONMENT=development
# DEBUG=false
#
# REQUIRED in production — a long random value (>= 32 chars), NEVER committed.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
#
# CORS: comma-separated EXACT origins allowed to call the API with credentials.
# Leave blank in dev (safe localhost defaults are used). "*" is rejected in prod.
# CORS_ALLOW_ORIGINS=https://app.example.com
#
# Trusted Host header allow-list (comma-separated); enforced in production only.
# ALLOWED_HOSTS=app.example.com,api.example.com
#
# Inbound API rate limiting (per client IP; in-process sliding window).
# ENABLE_RATE_LIMIT=true
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_S=60
# RATE_LIMIT_AUTH_REQUESTS=15
# RATE_LIMIT_AUTH_WINDOW_S=60
#
# Security response headers.
# ENABLE_SECURITY_HEADERS=true
# HSTS_MAX_AGE=31536000
# CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
#
# Session cookie hardening (forced to secure values when ENVIRONMENT=production).
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
# SESSION_MAX_AGE_DAYS=30

# Optional: PostgreSQL database
# DATABASE_URL=postgresql://user:password@localhost:5432/xray

# Optional: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Google Gemini (default active provider)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.1-flash-lite
# Free-tier requests-per-minute ceiling used by rate_limiter.py (keep under Google's cap)
# GEMINI_RPM_LIMIT=12

# Anthropic Claude (second first-class provider — does not replace Gemini)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# AI Chat Workspace (file/folder agent workspace) — configurable limits, no hardcoding
# WORKSPACE_STORAGE_DIR=backend/uploads/workspaces
# MAX_WORKSPACE_FILES=2000
# MAX_WORKSPACE_TOTAL_SIZE_MB=2000
# MAX_WORKSPACE_FILE_SIZE_MB=200
# MAX_AGENT_TOOL_CALLS_PER_TURN=25

# Translation throttling controls
# auto (default): enforce in production, disable in local dev
# on: always enforce
# off: disable hourly limiter everywhere
TRANSLATION_RATE_LIMIT_MODE=auto
TRANSLATION_LOCALHOST_UNLIMITED=true
# Applies only when limiter is enabled
MAX_REQUESTS_PER_USER_PER_HOUR=10

# Job size hard caps — raise for large decks/manuals (defaults: 2500 segments / 600000 chars)
MAX_SEGMENTS_PER_JOB=8000
MAX_CHARS_PER_JOB=1500000

# ── Connectors: Canva Connect API ────────────────────────────────────────────
# Create a Canva Developer integration at https://www.canva.com/developers/
# and register its redirect URI as EXACTLY:
#   http://127.0.0.1:8000/api/connectors/canva/callback
# (must match the backend port above; do not use "localhost" — Canva OAuth
# redirect URIs must match byte-for-byte).
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# Override only for non-local deployments; local dev computes this automatically.
# CANVA_REDIRECT_URI=

# Dedicated encryption key for connector tokens at rest (Canva's and every
# other connector's — one shared key, not one per provider, since they all
# go through the same encrypted-credential storage layer). Falls back to
# SESSION_SECRET if unset, so this is optional but recommended for
# production (rotating it then doesn't also invalidate login sessions).
# CONNECTOR_TOKEN_ENCRYPTION_KEY=

# ── Connectors: other OAuth2 platforms ───────────────────────────────────────
# One app per platform (not per connector) — register ALL of that platform's
# connector callback paths as additional redirect URIs on the same app:
#   Google Cloud OAuth client → covers google_drive, gmail, google_calendar
#     redirect URIs: http://127.0.0.1:8000/api/connectors/{google_drive,gmail,google_calendar}/callback
#   Google Drive specifically (the one currently enabled) uses EXACTLY:
#     http://127.0.0.1:8000/api/connectors/google_drive/callback
#   (underscore, matching every other connector's naming — not a hyphen)
#   Optional override, only needed if you can't register the underscore path:
#   GOOGLE_REDIRECT_URI=
#   Token encryption: do NOT set GOOGLE_TOKEN_ENCRYPTION_KEY if
#   CANVA_TOKEN_ENCRYPTION_KEY is already set below — the Canva key takes
#   priority for the one shared encryption key, so a Google-specific one
#   would have no effect unless the Canva key is removed first.
#   Microsoft Entra app registration → covers onedrive, sharepoint, teams
#     redirect URIs: http://127.0.0.1:8000/api/connectors/{onedrive,sharepoint,teams}/callback
#   Dropbox app console → http://127.0.0.1:8000/api/connectors/dropbox/callback
#   Atlassian developer console (3LO app) → http://127.0.0.1:8000/api/connectors/confluence/callback
#   Slack app (OAuth & Permissions) → http://127.0.0.1:8000/api/connectors/slack/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# GitHub / GitLab / Notion / SFTP / NAS / Custom REST need no app-level
# settings — each user supplies their own personal access token / SSH key /
# username+password / custom headers directly through the Connectors page.
